PORT=4000
SERVER_ADDRESS=localhost
PUBLIC_SERVER_URL=http://localhost:4000
PASS_PHRASE=your_passphrase_here

# --- 로컬 MongoDB ---
# MONGO_URI=mongodb://127.0.0.1:27017/instagram

# --- MongoDB Atlas (배포) ---
MONGO_USER=ashveil
MONGO_PASSWORD=your_atlas_password_here
MONGO_CLUSTER_HOST=cluster0.fira4pz.mongodb.net
MONGO_DB_NAME=instagram
# 또는 전체 URI (위 변수 대신 사용 가능):
# MONGO_URI=mongodb+srv://ashveil:YOUR_PASSWORD@cluster0.fira4pz.mongodb.net/instagram?retryWrites=true&w=majority&appName=Cluster0

# 배포 시 컨테이너 시작마다 초기 시드 (기본: true, 완료 후 자동 스킵)
RUN_DEPLOY_SEED=true
# 이미 시드된 DB를 다시 시드하려면 true
# FORCE_DEPLOY_SEED=true

# 릴스 시드 (선택): https://pixabay.com/api/docs/
PIXABAY_API_KEY=

# Docker / monorepo: 프론트 public 폴더 경로
# PUBLIC_DIR=/app/public
